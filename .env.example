# ==============================================================================
# MG Education & Social Development Organization
# Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# Application Environment
APP_NAME="MG Education & Social Development Organization"
APP_SHORT_NAME="MG Education"
APP_ENV="local"
APP_DEBUG=true
APP_URL="http://localhost/mgedu.in"
APP_TIMEZONE="Asia/Kolkata"

# Database Configuration (MySQL / MariaDB)
DB_CONNECTION="mysql"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="mgedu_db"
DB_USERNAME="root"
DB_PASSWORD=""
DB_CHARSET="utf8mb4"

# Mail Configuration (PHPMailer / SMTP)
MAIL_MAILER="smtp"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION="tls"
MAIL_FROM_ADDRESS="support@mgedu.in"
MAIL_FROM_NAME="MG Education Helpdesk"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_CURRENCY="INR"

# Redis Cache / Session (Predis)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=null

# Organization Details
ORG_CONTACT_PHONE="+91 98765 43210"
ORG_CONTACT_EMAIL="support@mgedu.in"
ORG_HEAD_OFFICE="MG Education Head Campus, India"
ORG_ISO_CERT="ISO 9001:2015 Certified"
ORG_NITI_DARPAN="NITI Aayog Darpan Registered"

